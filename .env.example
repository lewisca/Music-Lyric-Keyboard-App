# Copy this file to `.env` and fill in what you need. `.env` is gitignored.
# Every key is read SERVER-SIDE only (see lib/*.ts). Keys never reach the browser.
#
# NOTHING here is required to run. With no keys at all, the app runs in DEMO MODE:
# a keyless proposer picks a real song, iTunes fills real metadata + preview, and
# the lyric slot shows a placeholder marking where the licensed line will appear.

# ── Optional: better proposals ───────────────────────────────────────────────
# Anthropic API key — lets Claude do the semantic song matching instead of the
# keyless demo proposer. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Optional: resolution source ──────────────────────────────────────────────
# Which catalog verifies the suggestions and what the lyric slot shows:
#   (unset) / demo    → real metadata (iTunes) + a PLACEHOLDER lyric slot. Keyless.
#                       The default. Shows exactly where the licensed line lands.
#   itunes            → real metadata only, no lyric slot at all. Keyless.
#   musixmatch        → licensed adapter (paid; adds the real lyric snippet +
#                       attribution). Requires MUSIXMATCH_API_KEY; if missing,
#                       falls back to demo mode.
RESOLVER=demo

# ── Only needed if RESOLVER=musixmatch ───────────────────────────────────────
# Musixmatch API key (paid plans only — there is no longer a free tier).
# https://developer.musixmatch.com/
MUSIXMATCH_API_KEY=
